# Question: which requirements have no verification case?
# (Gap analysis, requirements with no verification.)
# Expected columns: ?requirement ?shortName
#
# Projection terms assumed (placeholders until docs/graph-contract.md fixes them):
#   proj: is a placeholder namespace; the projection vocabulary and its
#   namespace are open (OQ10) and are fixed by the graph contract.
#   proj:Requirement      class of requirement elements (Requirement stereotype)
#   proj:Component        class of component elements (decision 0005)
#   proj:shortName        declared short name of an element (literal)
#   proj:SatisfyClaim     one SysML `satisfy` relationship
#   proj:requirement      object property, SatisfyClaim -> Requirement
#   proj:satisfiedBy      object property, SatisfyClaim -> satisfying element
#   proj:verdict          verdict from `sysmlv2 verify` for the claim:
#                         "satisfied", "violated", or "undecided" (literal)
#   proj:verifiedBy       object property, Requirement -> verification case

PREFIX proj: <https://weft.ghostsystems.ai/thread/0.1.0/>

SELECT ?requirement ?shortName
WHERE {
  ?requirement a proj:Requirement ;
               proj:shortName ?shortName .
  FILTER NOT EXISTS { ?requirement proj:verifiedBy ?verificationCase }
}
ORDER BY ?shortName
