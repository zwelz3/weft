{
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/handoff.py\" precompact || exit 1",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/handoff.py\" sessionstart || exit 1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
