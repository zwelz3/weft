# Term group: proj:SatisfyClaim, proj:requirement, proj:satisfiedBy.
PREFIX sysml: <https://www.omg.org/spec/SysML/20250201/>
PREFIX tk: <https://weft.ghostsystems.ai/spike1/toolkit-vocab#>
PREFIX proj: <https://weft.ghostsystems.ai/thread/0.1.0/>

CONSTRUCT {
  ?claim a proj:SatisfyClaim ;
         proj:requirement ?requirement ;
         proj:satisfiedBy ?element .
}
WHERE {
  ?claim a sysml:SatisfyRequirementUsage ;
         tk:satisfiedRequirement ?requirement ;
         tk:satisfyingFeature ?element .
}
