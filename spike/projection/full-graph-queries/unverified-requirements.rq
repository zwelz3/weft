# Spike 2 step 3: equivalent of queries/unverified-requirements.rq against
# the full normative graph.
#
# Expected columns: ?requirement ?shortName
PREFIX sysml: <https://www.omg.org/spec/SysML/20250201/>
PREFIX tk: <https://weft.ghostsystems.ai/spike1/toolkit-vocab#>

SELECT ?requirement ?shortName
WHERE {
  ?requirement a sysml:RequirementUsage ;
               tk:declaredShortName ?shortName .
  FILTER NOT EXISTS {
    ?membership a sysml:RequirementVerificationMembership ;
                tk:verifiedRequirement ?requirement ;
                tk:owningType ?objective .
    ?objective tk:owner ?verificationCase .
    ?verificationCase a sysml:VerificationCaseUsage .
  }
}
ORDER BY ?shortName
