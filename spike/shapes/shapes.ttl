    sh:property <https://weft.ghostsystems.ai/spike1/pump-library/property/Component_bearer-shape> ;
    sh:targetClass <https://weft.ghostsystems.ai/spike1/pump-library/class/Component> .

<https://weft.ghostsystems.ai/spike1/pump-library/shape/Controller> a sh:NodeShape ;
    sh:property <https://weft.ghostsystems.ai/spike1/pump-library/property/Component_bearer-shape>,
        <https://weft.ghostsystems.ai/spike1/pump-library/property/Controller_dataPort-shape> ;
    sh:targetClass <https://weft.ghostsystems.ai/spike1/pump-library/class/Controller> .

<https://weft.ghostsystems.ai/spike1/pump-library/shape/DataLink> a sh:NodeShape ;
    sh:targetClass <https://weft.ghostsystems.ai/spike1/pump-library/class/DataLink> .

