        <https://weft.ghostsystems.ai/spike1/pump-library/property/Pump_powerPort-shape> ;
    sh:targetClass <https://weft.ghostsystems.ai/spike1/pump-library/class/Pump> .

<https://weft.ghostsystems.ai/spike1/pump-library/shape/PumpSystem> a sh:NodeShape ;
