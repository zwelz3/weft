@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://weft.ghostsystems.ai/spike1/pump-library/shape/BearerKind> a sh:NodeShape ;
    sh:targetClass <https://weft.ghostsystems.ai/spike1/pump-library/class/BearerKind> .

